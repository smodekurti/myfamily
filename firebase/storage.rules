rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User profile images
    match /users/{userId}/profile/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Family photos
    match /families/{familyId}/photos/{fileName} {
      allow read, write: if request.auth != null && 
        request.auth.uid in firestore.get(/databases/(default)/documents/families/{familyId}).data.members;
    }
    
    // Task attachments
    match /families/{familyId}/tasks/{taskId}/attachments/{fileName} {
      allow read, write: if request.auth != null && 
        request.auth.uid in firestore.get(/databases/(default)/documents/families/{familyId}).data.members;
    }
    
    // All other paths are denied
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
